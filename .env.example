# J.A.R.V.I.S. — Secrets
# Copy this file to ".env" (same folder) and fill in your keys.
# ".env" is gitignored and is the SINGLE place for API keys. It is read by both
# the direct Tavily call and the Tavily MCP server subprocess.

# Tavily web-answer API key — https://app.tavily.com/  (format: tvly-...)
TAVILY_API_KEY=

# Google Gemini API key — https://aistudio.google.com/  (format: AIzaSy...)
GEMINI_API_KEY=

# Groq API key — https://console.groq.com/  (format: gsk_...)
GROQ_API_KEY=

# LLM Provider selection (optional — defaults to config/settings.toml):
# Options: ollama | hybrid | gemini | groq
# JARVIS_LLM_PROVIDER=hybrid
# JARVIS_CLOUD_PROVIDER=gemini
