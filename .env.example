# J.A.R.V.I.S. — Secrets
# Copy this file to ".env" (same folder) and fill in your keys.
# ".env" is gitignored and is the SINGLE place for API keys. It is read by both
# the direct Tavily call and the Tavily MCP server subprocess.

# Tavily web-answer API key — https://app.tavily.com/  (format: tvly-...)
TAVILY_API_KEY=
